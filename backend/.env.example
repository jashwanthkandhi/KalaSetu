# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# NVIDIA NIM — LLM + Image (share same API key)
NVIDIA_NIM_API_KEY=nvapi-placeholder
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nemotron-3-nano-omni-30b-a3b-reasoning
QWEN_IMAGE_MODEL=Qwen-Image 2.0

# STT
WHISPER_MODEL=base
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Pricing
SERPAPI_KEY=placeholder

# TTS (P1 — Google Cloud or Sarvam Bulbul)
TTS_PROVIDER=google
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3

# Development
MOCK_MODE=false
LOG_LEVEL=INFO

# Optional deployed NIM image-edit endpoint; leave empty to preserve original photos.
QWEN_IMAGE_ENDPOINT=
LOCAL_WHISPER_ENABLED=false
# Durable jobs: server-only credential, never copy into Android or NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=
JOB_WORKERS=5
JOB_WORKER_ENABLED=true
# OpenAI-compatible image+text endpoint, explicitly configured and verified for vision.
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
